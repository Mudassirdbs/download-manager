<Window x:Class="DownloadManager.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DownloadManager.App"
        Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
        Icon="pack://application:,,,/app.ico" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16">
    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="UrlText" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Status" Foreground="#6B7280" />
      <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Text="Downloaded" Foreground="#6B7280" Margin="0,3,0,0" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DownloadedText" Margin="0,3,0,0" />
      <TextBlock Grid.Row="2" Text="Speed" Foreground="#6B7280" Margin="0,3,0,0" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Speed}" Margin="0,3,0,0" />
      <TextBlock Grid.Row="3" Text="Time left" Foreground="#6B7280" Margin="0,3,0,0" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimeLeft}" Margin="0,3,0,0" />
    </Grid>

    <Grid Height="20">
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Maximum="100" />
      <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
    </Grid>
    <local:SegmentBar x:Name="Segments" Height="8" Margin="0,4,0,0" />

    <CheckBox x:Name="ShowBox" Content="Show this window when a download starts" Margin="0,12,0,0"
              Click="OnShowChanged" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource DialogButton}" Click="OnPauseResume" />
      <Button x:Name="OpenButton" Content="Open" Style="{StaticResource PrimaryButton}" Click="OnOpen" Visibility="Collapsed" />
      <Button x:Name="FolderButton" Content="Open folder" Style="{StaticResource DialogButton}" Click="OnOpenFolder" Visibility="Collapsed" />
      <Button x:Name="HideButton" Content="Hide" Style="{StaticResource DialogButton}" Click="OnHide" />
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DialogButton}" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
