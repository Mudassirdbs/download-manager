<Window x:Class="DownloadManager.App.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tools" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/app.ico" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,12">
      Streams and site videos use two free tools. ffmpeg combines video and audio into MP4; yt-dlp reads
      sites such as YouTube and DASH manifests. Installs go to your user profile and are checked against the
      publisher's SHA-256.
    </TextBlock>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="ffmpeg" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="FfmpegText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Button Grid.Column="2" x:Name="FfmpegButton" Padding="12,4" Margin="8,0,0,0" Click="OnInstallFfmpeg" />
    </Grid>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="yt-dlp" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="YtDlpText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Button Grid.Column="2" x:Name="YtDlpButton" Padding="12,4" Margin="8,0,0,0" Click="OnInstallYtDlp" />
    </Grid>

    <TextBlock x:Name="StatusText" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0" />
    <Button Content="Close" HorizontalAlignment="Right" Padding="16,6" Margin="0,12,0,0" IsCancel="True" />
  </StackPanel>
</Window>
