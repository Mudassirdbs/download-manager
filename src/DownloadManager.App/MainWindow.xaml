<Window x:Class="DownloadManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DownloadManager" Width="1000" Height="560" MinWidth="640" MinHeight="320"
        Icon="pack://application:,,,/app.ico" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="#F9FAFB">
      <StackPanel Orientation="Horizontal">
        <Button Content="Add URL" Style="{StaticResource ToolButton}" Click="OnAdd" />
        <Button Content="Resume" Style="{StaticResource ToolButton}" Click="OnResume" />
        <Button Content="Pause" Style="{StaticResource ToolButton}" Click="OnPause" />
        <Button Content="Delete" Style="{StaticResource ToolButton}" Click="OnDelete" />
        <Separator Margin="6,0" />
        <Button Content="Resume all" Style="{StaticResource ToolButton}" Click="OnResumeAll" />
        <Button Content="Pause all" Style="{StaticResource ToolButton}" Click="OnPauseAll" />
        <Separator Margin="6,0" />
        <Button Content="Open folder" Style="{StaticResource ToolButton}" Click="OnOpenFolder" />
        <Button Content="Tools" Style="{StaticResource ToolButton}" Click="OnTools" />
        <Separator Margin="6,0" />
        <TextBlock Text="Connections" VerticalAlignment="Center" Margin="4,0,6,0" />
        <ComboBox x:Name="ConnectionsBox" Width="56" VerticalContentAlignment="Center"
                  ToolTip="Connections per download (new and resumed downloads)" SelectionChanged="OnConnectionsChanged" />
        <TextBlock Text="Speed limit" VerticalAlignment="Center" Margin="12,0,6,0" />
        <ComboBox x:Name="GlobalSpeedBox" Width="104" VerticalContentAlignment="Center" DisplayMemberPath="Label"
                  ToolTip="Combined limit for all downloads" SelectionChanged="OnGlobalSpeedChanged" />
      </StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="SummaryText" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="BridgeText" />
      </StatusBarItem>
    </StatusBar>

    <DataGrid x:Name="DownloadsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" SelectionMode="Extended"
              CanUserResizeRows="False" RowHeight="26" BorderThickness="0" MouseDoubleClick="OnRowDoubleClick">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open" Click="OnOpenFile" />
          <MenuItem Header="Open folder" Click="OnOpenFolder" />
          <Separator />
          <MenuItem Header="Resume" Click="OnResume" />
          <MenuItem Header="Pause" Click="OnPause" />
          <MenuItem Header="Speed limit" x:Name="ItemSpeedMenu" />
          <Separator />
          <MenuItem Header="Copy address" Click="OnCopyUrl" />
          <Separator />
          <MenuItem Header="Delete from list" Click="OnDelete" />
          <MenuItem Header="Delete with file" Click="OnDeleteWithFile" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="2*" />
        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="110" />
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
        <DataGridTemplateColumn Header="Progress" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid Margin="2,3">
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="90" />
        <DataGridTextColumn Header="Time left" Binding="{Binding TimeLeft}" Width="80" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*" />
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
        <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="130" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
